{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reverse-skill.local/schemas/carrier-manifest.json",
  "title": "CarrierManifest",
  "description": "Frozen carrier manifest contract, version 1.0 (spec 4.0 table, owner T23). It describes one customer-facing carrier: either the development checkout or a release bundle produced by 17.14/17.15, together with the 17.18 end-to-end fixtures that must pass on that carrier. T02 provides the schema and the validator subset; T23 owns the producer, the digests and the fixture execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "carrier_id",
    "carrier_kind",
    "created_at",
    "generator",
    "generator_version",
    "bundle_root",
    "no_git",
    "platforms",
    "members",
    "required_members",
    "digests",
    "release",
    "fixtures"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "carrier_id": {
      "description": "Unique carrier id; also the single-writer lock key of 17.14.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "carrier_kind": {
      "enum": ["dev_checkout", "release_bundle"]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "generator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "generator_version": {
      "description": "Semantic version of the producer.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "bundle_root": {
      "description": "Relative path of the carrier root; resolved by the 17.16 canonical path resolver.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "no_git": {
      "description": "True when the carrier must run without a .git directory.",
      "type": "boolean"
    },
    "platforms": {
      "description": "Only platforms with a real CI job or fixture may be listed (17.20).",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "enum": ["windows", "linux", "macos"]
      }
    },
    "members": {
      "description": "Carrier membership. Ordering inside the digest manifest is defined by 17.26; this array records the entries themselves.",
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kind": {
            "enum": ["file", "directory"]
          },
          "sha256": {
            "description": "Required for kind=file; enforced by the contract test.",
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10737418240
          }
        }
      }
    },
    "required_members": {
      "description": "Bundle members fixed by 17.15. A release_bundle carrier must contain every entry; the contract test enforces presence, the schema only fixes the vocabulary.",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "enum": [
          "release-manifest.json",
          "source-lock.json",
          "registry.json",
          "schemas/",
          "NOTICE/",
          "SBOM/",
          "checksums/",
          "signatures/",
          "validation/"
        ]
      }
    },
    "digests": {
      "description": "Digests of the carrier-level artifacts. A digest without reproducible content is local-only (17.15).",
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "schemas"],
      "properties": {
        "registry": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schemas": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "notice": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "checksums_manifest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_lock": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "release": {
      "description": "Release mode and signature binding of this carrier (17.14/17.15).",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "redistributable", "signatures"],
      "properties": {
        "mode": {
          "enum": ["local_only", "release"]
        },
        "redistributable": {
          "type": "boolean"
        },
        "signatures": {
          "description": "A redistributable release needs at least one entry; the contract test enforces the count and the field set from 17.15.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signer", "trust_root", "key_id", "signed_at", "rotation", "revocation"],
            "properties": {
              "signer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "trust_root": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "key_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "signed_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
              },
              "rotation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "revocation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        }
      }
    },
    "fixtures": {
      "description": "Customer-skin end-to-end fixtures (17.18). Every fixture fixes cwd, runtime, dependencies, input, expected status, expected exit code, expected stdout/stderr evidence and the expected JSON assertion.",
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "cwd",
          "runtime",
          "dependencies",
          "inputs",
          "expected_status",
          "expected_exit_code"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "runtime": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "dependencies": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "expected_status": {
            "enum": ["matched", "needs_review", "blocked", "missing_input", "unavailable", "failed"]
          },
          "expected_exit_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "expected_stdout_contains": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "expected_stderr_contains": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "expected_json": {
            "description": "JSON Pointer style assertions on the parsed output, for example /status or /matches/0/path.",
            "type": "object",
            "maxProperties": 64
          }
        }
      }
    },
    "extensions": {
      "description": "Only extension slot (4.0 rule 4), at or below 4096 bytes.",
      "type": "object",
      "maxProperties": 32
    }
  }
}
