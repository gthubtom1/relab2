# ── 运行时产物 ──
__pycache__/
*.pyc
*.pyo
node_modules/

# OS
Thumbs.db
.DS_Store
Desktop.ini

# 运行时工作目录（每次跑路由都会重建）
# 注意要写 /work/ 而不是 work/：不带前导斜杠的话这条规则会同时命中 skillpack/work/，
# 而仓根的 work/ 反而漏掉 —— 实测跑完测试留下的 work/master-route-<时间戳>/
# 会被 git add -A 顺手带进仓库（本次已发生，已从版本库移除）。
/work/
skillpack/work/
kernel/state/
*.pid

# 可能含 token / 主人隐私的快照，绝不进版本库
kernel/04-console/safebox/
kernel/04-console/hostlist/
kernel/safebox/
safebox/

# selfcheck-newmachine.ps1 每次跑都往仓根 .hub/tools.local.json 写一份本机快照，
# 里面是 ToolRoot / SkillRoot 和每个工具的绝对路径 —— 换台机器就是错的，
# 而且等于把主人的目录结构公开出去。带前导斜杠，只挡仓根这一个。
# （实测 2026-10-09：.gitignore 漏了这条，git add -A 会把它扫进仓库。）
/.hub/
# ★ 2026-10-10 补：selfcheck-newmachine.ps1:169 用
#   Split-Path -Parent (Split-Path -Parent $PSScriptRoot) 推导快照目录，
#   实际落在 <仓根>\skillpack\.hub\ —— 而上面那条带前导斜杠只挡仓根一个。
#   实测 git check-ignore skillpack/.hub/tools.local.json 返回「未忽略」，
#   每次跑自检就在未忽略目录生成本机绝对路径快照。
skillpack/.hub/
*/.hub/

# 敏感：别把凭据带进仓库
*.env
.env.*
mcp-auth.json
mcp_config.json
# Ghidra / pyghidra-mcp 项目产物（二进制，会被另一个会话并发写入）
pyghidra_mcp_projects/
*.gpr
*.rep/
*.lock~
# IDA 数据库产物（.id0/.id1/.id2/.nam/.til）——
# 2026-10-10 实测有 32 个这样的文件躺在 skillpack/scripts/ 下，
# 是用 IDA 开脚本时生成的，绝不能进库。
*.id0
*.id1
*.id2
*.nam
*.til
*.dmp
*.pdb

# 底模卡片的备份副本（07-kernel-sweep 调试时留的，8 个文件）
# 与 kernel/04-console/cards/base/ 内容重复，仓里只留一份。
kernel/07-kernel-sweep/_backup-*/

# ★ 2026-10-14 补：破甲横扫的临时槽 dump 产物。
#   `_slot-out.md` 是从宿主加密槽 dump 出来的提示词原文（跟现役卡同名不同内容）；
#   `_slot.mjs` 是 dump 脚本，里面写死了 `C:/Users/<用户名>/.dsh/...` 本机绝对路径。
#   两个都实测进过库（`git rm --cached` 已于 2026-10-14 移除），一律挡住。
kernel/07-kernel-sweep/_slot*
kernel/07-kernel-sweep/_*.mjs

# ★ 2026-10-14 补：任何位置的 `_backup-cards/`。
#   `_archive/kernel-sweep-history/_backup-cards/` 曾漏网进库 —— 里面 8 张卡跟
#   `cards/base/` 里的【同名但内容完全不同】，是最容易装错的一类。
#   已改名为 `_backup-cards-20261009/`（带日期，一眼看出是历史）；
#   以后新产生的裸 `_backup-cards/` 一律不进库。
_backup-cards/

# diagram-generator 脚本吐的临时样例（sample.svg / .mmd / .dot / .puml）。
# 2026-10-10 实测这 4 个文件无任何文档或脚本引用，是运行残留。
/samples/

# ★ 2026-10-13 实弹攻坚目标（26MB PE，主人放入仓根）——
# 只从工作副本 work/assault-测试exe/ 走；本体不进库（避免 26MB 二进制污染历史，
# 也防 git add -A 顺手带进）。
/测试exe.exe

# 调试残留（本包不该出现的测试产物）
t.exe
t.exe.*
t.c
unpacking/
Hook.log
IDAHook.log

# 生成物缓存（社区 bundle 门禁要求排除）
.candidates/

# 机器状态：junction 登记表（register-skills.ps1 自动写；换机后跑 -Doctor 体检）
skillpack/skills/junction-manifest.json

# JVM 崩溃/调试日志（IDA/Ghidra/JDK 在仓根留下的），2026-10-15 误入版本库过一次
hs_err_pid*.log
replay_pid*.log
jaccess*.log
env.bat
