# ── 运行时产物 ──
__pycache__/
*.pyc
*.pyo
node_modules/

# OS
Thumbs.db
.DS_Store
Desktop.ini

# 运行时工作目录（每次跑路由都会重建）
# 注意要写 /work/ 而不是 work/：不带前导斜杠的话这条规则会同时命中 skillpack/work/，
# 而仓根的 work/ 反而漏掉 —— 实测跑完测试留下的 work/master-route-<时间戳>/
# 会被 git add -A 顺手带进仓库（本次已发生，已从版本库移除）。
/work/
skillpack/work/
kernel/state/
*.pid

# 可能含 token / 主人隐私的快照，绝不进版本库
kernel/04-console/safebox/
kernel/04-console/hostlist/
kernel/safebox/
safebox/

# selfcheck-newmachine.ps1 每次跑都往仓根 .hub/tools.local.json 写一份本机快照，
# 里面是 ToolRoot / SkillRoot 和每个工具的绝对路径 —— 换台机器就是错的，
# 而且等于把主人的目录结构公开出去。带前导斜杠，只挡仓根这一个。
# （实测 2026-10-09：.gitignore 漏了这条，git add -A 会把它扫进仓库。）
/.hub/

# 敏感：别把凭据带进仓库
*.env
.env.*
mcp-auth.json
mcp_config.json
# Ghidra / pyghidra-mcp 项目产物（二进制，会被另一个会话并发写入）
pyghidra_mcp_projects/
*.gpr
*.rep/
*.lock~

# 调试残留（本包不该出现的测试产物）
t.exe
t.exe.*
t.c
unpacking/
Hook.log
IDAHook.log

# 生成物缓存（社区 bundle 门禁要求排除）
.candidates/
